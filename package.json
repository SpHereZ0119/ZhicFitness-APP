{
  "name": "zhic-life-local",
  "version": "1.2.0",
  "author": "朱立晨 <3467218852@qq.com>",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "description": "个人本地学习与生活工作台",
  "scripts": {
    "start": "node server.mjs",
    "build:web": "node scripts/build-web.mjs",
    "desktop:dev": "npm run build:web && electron electron/main.cjs",
    "desktop:build": "npm run build:web && electron-builder --win portable",
    "desktop:installer": "npm run build:web && electron-builder --win nsis",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:build": "node scripts/build-mobile.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:android": "node scripts/verify-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
